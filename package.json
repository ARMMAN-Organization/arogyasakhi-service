{
  "name": "arogya-backend",
  "version": "0.1.0",
  "description": "Arogya Sakhi backend — Nx monorepo of independently deployable Express microservices.",
  "private": true,
  "workspaces": [
    "apps/*",
    "libs/*"
  ],
  "engines": {
    "node": ">=20.11.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "build": "nx run-many -t build",
    "test": "nx run-many -t test",
    "lint": "nx run-many -t lint",
    "format": "prettier --write \"{apps,libs}/**/*.{ts,json,md}\"",
    "format:check": "prettier --check \"{apps,libs}/**/*.{ts,json,md}\"",
    "affected:build": "nx affected -t build",
    "affected:test": "nx affected -t test",
    "affected:lint": "nx affected -t lint",
    "graph": "nx graph",
    "db:generate": "node tools/prisma-foreach.js generate",
    "db:push": "node tools/prisma-foreach.js db push",
    "db:setup": "npm run db:push",
    "migrate": "node tools/prisma-foreach.js migrate deploy",
    "db:migrate": "npm run migrate",
    "serve:all": "nx run-many -t build --projects=service-commons,core && nx run-many -t serve --all --parallel=16",
    "postinstall": "npm run db:generate",
    "prepare": "husky"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.29.7",
    "@commitlint/cli": "^19.4.0",
    "@commitlint/config-conventional": "^19.2.2",
    "@nx/eslint": "^19.5.0",
    "@nx/eslint-plugin": "^19.8.0",
    "@nx/jest": "^19.5.0",
    "@nx/js": "^19.5.0",
    "@nx/webpack": "^19.8.14",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.0",
    "babel-jest": "^29.7.0",
    "eslint": "^9.9.0",
    "husky": "^9.1.4",
    "jest": "^29.7.0",
    "lint-staged": "^15.2.9",
    "nx": "^19.5.0",
    "prettier": "^3.3.3",
    "prisma": "5.22.0",
    "ts-jest": "^29.2.4",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.0.0"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "jose": "^6.2.3"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
