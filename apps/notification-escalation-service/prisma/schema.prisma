generator client {
  provider = "prisma-client-js"
  output   = "../../../node_modules/.prisma/client-notification-escalation-service"
}

datasource db {
  provider  = "postgresql"
  directUrl = env("DIRECT_URL")
  url       = env("DATABASE_URL")
}

// notification-escalation-service owns these tables only (forklift rule).
// Field/table definitions sourced from docs/Arogya_Sakhi_Database_Design_ERD_Table_Definitions.docx.md
// section "escalation_events", "notifications" (Appendix A).
// beneficiary_id / visit_id / referral_id / trigger_rule_version_id / assigned_supervisor_id /
// recipient_user_id / linked_entity_id are plain scalar columns, not Prisma relations, because
// beneficiary_cases, visit_instances, referrals, rule_versions, supervisor_profiles, and users
// are owned by other services (no cross-service joins per the forklift rule).

enum EscalationType {
  ANC_2_MISSED
  ANC_HR_MISSED
  PP_MISSED
  PP_HR_MISSED
  NN_MISSED
  NN_HR_MISSED
  INC_2_MISSED
  INC_HR_MISSED
  CCV_MISSED
  CCV_HR_MISSED
  POST_EDD_MISSED
  DELIVERY_FORM_PENDING
  REFERRAL_FOLLOWUP_MISSED
  REFERRAL_INCOMPLETE
  TRANSFER_PENDING
  TRANSFER_APPROVAL_PENDING
  SYNC_DELAY
  CLOSURE_PENDING
  REOPEN_PENDING
  // Quick Response's EDD_NEARING card type — distinct from POST_EDD_MISSED
  // (the EDD has already passed); this fires while it's still approaching.
  EDD_NEARING
}

enum EscalationStatus {
  OPEN
  ACKNOWLEDGED
  TRANSFER_REQUESTED
  CLOSE_REQUESTED
  RESOLVED
  DISMISSED
}

enum NotificationType {
  MISSED_VISIT_ESCALATION
  // Missed Visit Escalation TRANSFER (FR-SV-4.3) — the Sakhi's in-app
  // notification that her beneficiary has been removed from her active
  // list pending a Manager's review.
  BENEFICIARY_TRANSFER_NOTICE
  REFERRAL_UPDATE
  REFERRAL_FOLLOWUP_DUE
  REFERRAL_FOLLOWUP_OVERDUE
  REOPEN_UPDATE
  CLOSURE_UPDATE
  LMP_CHANGE_UPDATE
  FORM_UPDATE
  DATA_SYNC_STATUS
  VISIT_NEAR_MISS
  EDD_APPROACHING
  EDD_OVERDUE
  SUPERVISOR_APPROVAL_REQUESTED
  SUPERVISOR_APPROVAL_DECISION
  APP_UPDATE_REQUIRED
  MEETING_REMINDER
  TRAINING_REMINDER
  MEETING_UPDATE
  TRAINING_UPDATE
}

enum NotificationStatus {
  UNREAD
  READ
  DISMISSED
  EXPIRED
}

model EscalationEvent {
  id                   String           @id @default(uuid()) @map("escalation_id")
  // beneficiary_cases.beneficiary_id — owned by another service, no cross-service relation.
  beneficiaryId        String           @map("beneficiary_id")
  // visit_instances.visit_id — owned by another service, no cross-service relation.
  visitId              String?          @map("visit_id")
  // referrals.referral_id — owned by another service, no cross-service relation.
  referralId           String?          @map("referral_id")
  escalationType       EscalationType   @map("escalation_type")
  // rule_versions.rule_version_id — owned by another service, no cross-service relation.
  triggerRuleVersionId String?          @map("trigger_rule_version_id")
  status               EscalationStatus @map("status")
  // supervisor_profiles.supervisor_id — owned by another service, no cross-service relation.
  assignedSupervisorId String?          @map("assigned_supervisor_id")
  // Missed Visit Escalation detail only — no confirmed data source yet, so this
  // is populated by whatever upstream process creates the row; null until then.
  visitsMissedCount    Int?             @map("visits_missed_count")
  resolvedAt           DateTime?        @map("resolved_at")
  // TRANSFER_REQUESTED only (FR-SV-4.3) — the Manager's review deadline,
  // stamped at decision time as now + 15 days. Null for every other status.
  reviewDeadlineAt     DateTime?        @map("review_deadline_at")
  actionTaken          String?          @map("action_taken") @db.VarChar(80)
  // CLOSURE_PENDING only (POST /escalations/:id/closure-pending-reason) — why the
  // closure form hasn't been submitted yet. auth-service's CLOSURE_PENDING_REASON
  // lookup_value_id — environment-specific FK, not a stable literal, same convention
  // as escalation_events has none of its own for other cross-service lookups.
  // Distinct from actionTaken, which records a *decision outcome* (CLOSE/TRANSFER),
  // not a still-pending status explanation.
  pendingReasonLookupValueId String?    @map("pending_reason_lookup_value_id")
  // Required only when pendingReasonLookupValueId resolves to OTHER.
  pendingReasonNotes         String?    @map("pending_reason_notes") @db.VarChar(500)
  pendingReasonSubmittedAt   DateTime?  @map("pending_reason_submitted_at")
  createdAt            DateTime         @default(now()) @map("created_at")
  createdByUserId      String?          @map("created_by_user_id")
  updatedAt            DateTime         @updatedAt @map("updated_at")
  updatedByUserId      String?          @map("updated_by_user_id")
  isDeleted            Boolean          @default(false) @map("is_deleted")
  deletedAt            DateTime?        @map("deleted_at")

  @@map("escalation_events")
}

model Notification {
  id               String             @id @default(uuid()) @map("notification_id")
  // users.user_id — owned by another service, no cross-service relation.
  recipientUserId  String             @map("recipient_user_id")
  notificationType NotificationType   @map("notification_type")
  title            String             @db.VarChar(180)
  body             String?
  priority         Int                @default(5)
  ctaType          String?            @map("cta_type") @db.VarChar(80)
  linkedEntityType String?            @map("linked_entity_type") @db.VarChar(80)
  // Generic polymorphic reference (linked_entity_type names the owning table); no
  // cross-service relation regardless of which service owns that entity type.
  linkedEntityId   String?            @map("linked_entity_id")
  status           NotificationStatus @map("status")
  readAt           DateTime?          @map("read_at")
  dismissedAt      DateTime?          @map("dismissed_at")
  createdAt        DateTime           @default(now()) @map("created_at")
  createdByUserId  String?            @map("created_by_user_id")
  updatedAt        DateTime           @updatedAt @map("updated_at")
  updatedByUserId  String?            @map("updated_by_user_id")
  isDeleted        Boolean            @default(false) @map("is_deleted")
  deletedAt        DateTime?          @map("deleted_at")

  @@map("notifications")
}
