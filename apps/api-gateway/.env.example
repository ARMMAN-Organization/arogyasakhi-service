NODE_ENV=development
PORT=3000
LOG_LEVEL=debug
CORS_ORIGINS=http://localhost:5173

# Public half of the RS256 keypair used by auth-service to sign tokens (see
# apps/auth-service/.env.example for how to generate a local dev pair). The
# gateway only verifies tokens, so only the public key is needed here.
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nREPLACE_ME\n-----END PUBLIC KEY-----"

# Downstream service base URLs (host only — the gateway forwards the path).
# Defaults match local `npm run serve:all` ports. In production set these to
# the internal service DNS names. The gateway reaches services ONLY via these
# URLs over HTTP — it never imports another service's code.
AUTH_SERVICE_URL=http://localhost:3002
BENEFICIARY_SERVICE_URL=http://localhost:3001
VISIT_FORM_SERVICE_URL=http://localhost:3003
RULES_SERVICE_URL=http://localhost:3004
RISK_REFERRAL_SERVICE_URL=http://localhost:3005
CLOSURE_REOPEN_SERVICE_URL=http://localhost:3006
APPROVAL_SERVICE_URL=http://localhost:3007
INCENTIVE_WAGES_SERVICE_URL=http://localhost:3008
NOTIFICATION_ESCALATION_SERVICE_URL=http://localhost:3009
SYNC_SERVICE_URL=http://localhost:3010
MEDIA_SERVICE_URL=http://localhost:3011
AUDIT_SERVICE_URL=http://localhost:3013
CMS_CONTENT_SERVICE_URL=http://localhost:3014
SUPERVISOR_OPERATIONS_SERVICE_URL=http://localhost:3016
