# auth-service environment — copy to .env and fill in real values per environment.
NODE_ENV=development
PORT=3002
LOG_LEVEL=debug
CORS_ORIGINS=http://localhost:5173
# Comma-separated public URLs for the Swagger "Servers" dropdown, e.g.
# https://staging-api.example.com,https://api.example.com. Leave empty in
# local dev to fall back to http://localhost:$PORT.
PUBLIC_BASE_URLS=
DATABASE_URL=postgresql://armman:armman@localhost:5432/arogya?schema=auth_service
DIRECT_URL=postgresql://armman:armman@localhost:5432/arogya?schema=auth_service
REDIS_URL=redis://localhost:6379
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_ME\n-----END PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nREPLACE_ME\n-----END PUBLIC KEY-----"
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=30d
ADMIN_USERNAME=REPLACE_ME
ADMIN_MOBILE_NUMBER=+910000000000
ADMIN_PASSWORD=REPLACE_ME
# Base64-encoded 32-byte key (e.g. `openssl rand -base64 32`), used to decrypt
# sakhi_profiles.bank_account_token for GET /me's maskedBankAccount field.
# Real value lives only in the gitignored .env.
PII_ENCRYPTION_KEY=REPLACE_ME
