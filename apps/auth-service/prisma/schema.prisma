generator client {
  provider = "prisma-client-js"
  output   = "../../../node_modules/.prisma/client-auth-service"
}

datasource db {
  provider  = "postgresql"
  directUrl = env("DIRECT_URL")
  url       = env("DATABASE_URL")
}

// auth-service owns these tables only (forklift rule).
// Field/table definitions sourced from docs/Arogya_Sakhi_Database_Design_ERD_Table_Definitions.docx.md
// section "users", "roles", "user_roles", "user_sessions" (Appendix A.1).
// project_id / geography_unit_id / device_id are plain scalar columns, not Prisma
// relations, because projects/geography_units/device_registry are owned by other
// services (no cross-service joins per the forklift rule).

enum UserStatus {
  ACTIVE
  INACTIVE
  LOCKED
  PAUSED
  DELETED
}

enum UserRoleStatus {
  ACTIVE
  EXPIRED
  REVOKED
  INACTIVE
}

model User {
  id                String     @id @default(uuid()) @map("user_id")
  // Contact/identity field per the ERD's users table — no longer a login
  // credential; login is username + password only, for every role.
  mobileNumber      String     @unique @map("mobile_number") @db.VarChar(13)
  // Sole login identifier per SRS FR-S-1.1 ("Sakhi must authenticate using
  // Username and password"), applied to every role rather than SAKHI only.
  // Not in the ERD's users table — added because the SRS is authoritative
  // over the ERD/HLD for this project. Required and unique.
  username          String     @unique @db.VarChar(50)
  passwordHash      String     @map("password_hash") @db.VarChar(255)
  displayName       String     @map("display_name") @db.VarChar(160)
  email             String?    @unique @db.VarChar(254)
  status            UserStatus @default(ACTIVE)
  lastLoginAt       DateTime?  @map("last_login_at")
  failedLoginCount  Int        @default(0) @map("failed_login_count")
  passwordChangedAt DateTime?  @map("password_changed_at")
  createdAt         DateTime   @default(now()) @map("created_at")
  createdByUserId   String?    @map("created_by_user_id")
  updatedAt         DateTime   @updatedAt @map("updated_at")
  updatedByUserId   String?    @map("updated_by_user_id")
  isDeleted         Boolean    @default(false) @map("is_deleted")
  deletedAt         DateTime?  @map("deleted_at")

  userRoles    UserRole[]
  userSessions UserSession[]
  sakhiProfile SakhiProfile?

  @@map("users")
}

model Role {
  id              String    @id @default(uuid()) @map("role_id")
  roleCode        String    @unique @map("role_code") @db.VarChar(50)
  roleName        String    @map("role_name") @db.VarChar(120)
  description     String?
  isActive        Boolean   @default(true) @map("is_active")
  createdAt       DateTime  @default(now()) @map("created_at")
  createdByUserId String?   @map("created_by_user_id")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  updatedByUserId String?   @map("updated_by_user_id")
  isDeleted       Boolean   @default(false) @map("is_deleted")
  deletedAt       DateTime? @map("deleted_at")

  userRoles UserRole[]

  @@map("roles")
}

model UserRole {
  id              String         @id @default(uuid()) @map("user_role_id")
  userId          String         @map("user_id")
  roleId          String         @map("role_id")
  // projects live in this same schema (auth-service also owns project/funder
  // master data — see the Funder/Project models below), so this is a real
  // Prisma relation, not a cross-service scalar.
  projectId       String?        @map("project_id")
  project         Project?       @relation(fields: [projectId], references: [projectId])
  // geography_units.geography_unit_id — same schema too, but no relation is
  // declared here yet; left as a plain scalar until a caller actually needs it.
  geographyUnitId String?        @map("geography_unit_id")
  effectiveFrom   DateTime       @map("effective_from")
  effectiveTo     DateTime?      @map("effective_to")
  status          UserRoleStatus @default(ACTIVE)
  createdAt       DateTime       @default(now()) @map("created_at")
  createdByUserId String?        @map("created_by_user_id")
  updatedAt       DateTime       @updatedAt @map("updated_at")
  updatedByUserId String?        @map("updated_by_user_id")
  isDeleted       Boolean        @default(false) @map("is_deleted")
  deletedAt       DateTime?      @map("deleted_at")

  user User @relation(fields: [userId], references: [id])
  role Role @relation(fields: [roleId], references: [id])

  @@map("user_roles")
}

model UserSession {
  id               String    @id @default(uuid()) @map("session_id")
  userId           String    @map("user_id")
  refreshTokenHash String    @unique @map("refresh_token_hash") @db.VarChar(255)
  // device_registry.device_id — deferred; not modeled yet per current scope.
  deviceId         String?   @map("device_id")
  issuedAt         DateTime  @map("issued_at")
  // Nullable: sessions no longer expire by time (see AuthService.issueTokens)
  // — only an explicit /auth/logout or admin revocation sets revokedAt below.
  // Null on every session created after that change; a pre-existing session
  // from before it keeps its original real timestamp until its next refresh
  // rotates it into a fresh, non-expiring one.
  expiresAt        DateTime? @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")
  ipAddress        String?   @map("ip_address") @db.VarChar(45)
  createdAt        DateTime  @default(now()) @map("created_at")
  createdByUserId  String?   @map("created_by_user_id")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  updatedByUserId  String?   @map("updated_by_user_id")
  isDeleted        Boolean   @default(false) @map("is_deleted")
  deletedAt        DateTime? @map("deleted_at")

  user User @relation(fields: [userId], references: [id])

  @@map("user_sessions")
}

// Not in the ERD — added to give backend jobs/crons a real machine identity
// (client-credentials grant) instead of forwarding a human's own JWT, which
// was the only "server-to-server" pattern that existed before this table.
// Deliberately separate from users/user_roles: a service account is never a
// person, never logs in via /auth/login, and never holds a session.
model ServiceAccount {
  id               String    @id @default(uuid()) @map("service_account_id")
  name             String    @db.VarChar(120)
  clientId         String    @unique @map("client_id") @db.VarChar(80)
  clientSecretHash String    @map("client_secret_hash") @db.VarChar(255)
  // The single role code embedded in every token this account mints, e.g.
  // "SYSTEM". A plain string (not a Role relation) — service accounts are
  // intentionally outside the human role/permission model.
  role             String    @db.VarChar(50)
  isActive         Boolean   @default(true) @map("is_active")
  // Same convention as User.failedLoginCount/lastLoginAt — clientIds aren't
  // secret (shipped in .env.example as descriptive strings like
  // "sync-service"), so there is otherwise no record kept anywhere of
  // repeated clientSecret guesses against POST /auth/service-token.
  lastAuthAt       DateTime? @map("last_auth_at")
  failedAuthCount  Int       @default(0) @map("failed_auth_count")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@map("service_accounts")
}

// Column set matches ERD Appendix A.1 (funders, projects) exactly.

enum FunderStatus {
  ACTIVE
  INACTIVE
}

model Funder {
  funderId        String       @id @default(uuid()) @map("funder_id")
  funderCode      String       @unique @map("funder_code") @db.VarChar(50)
  funderName      String       @map("funder_name") @db.VarChar(40)
  status          FunderStatus @default(ACTIVE)
  createdAt       DateTime     @default(now()) @map("created_at")
  createdByUserId String?      @map("created_by_user_id")
  updatedAt       DateTime     @updatedAt @map("updated_at")
  updatedByUserId String?      @map("updated_by_user_id")
  isDeleted       Boolean      @default(false) @map("is_deleted")
  deletedAt       DateTime?    @map("deleted_at")

  projects Project[]

  @@map("funders")
}

enum ProjectStatus {
  ACTIVE
  PAUSED
  CLOSED
}

model Project {
  projectId       String        @id @default(uuid()) @map("project_id")
  funderId        String?       @map("funder_id")
  funder          Funder?       @relation(fields: [funderId], references: [funderId])
  projectCode     String        @unique @map("project_code") @db.VarChar(80)
  projectName     String        @map("project_name") @db.VarChar(80)
  financialYear   String        @map("financial_year") @db.VarChar(9)
  startDate       DateTime      @map("start_date") @db.Date
  endDate         DateTime?     @map("end_date") @db.Date
  status          ProjectStatus @default(ACTIVE)
  createdAt       DateTime      @default(now()) @map("created_at")
  createdByUserId String?       @map("created_by_user_id")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  updatedByUserId String?       @map("updated_by_user_id")
  isDeleted       Boolean       @default(false) @map("is_deleted")
  deletedAt       DateTime?     @map("deleted_at")

  userRoles     UserRole[]
  sakhiProfiles SakhiProfile[]

  @@map("projects")
}

// Column set matches ERD Appendix A.1 ("sakhi_profiles") exactly.
// supervisorId is documented in the ERD as referencing
// supervisor_profiles.supervisor_id, but that table has no application code
// anywhere reading or writing it (dead schema) — every real write path
// (auth.service.ts's updateUser, via PATCH /users/:id) stores the
// Supervisor's users.user_id here instead, matching the JWT `sub` every
// other service treats as "the Supervisor's identity" (e.g.
// sakhi.service.ts's listByProject SUPERVISOR-ownership filter). Kept as a
// plain scalar (no relation) rather than inventing one, since there is
// nothing to relate to yet — but if supervisor_profiles is ever wired up,
// this column's actual contents (users.user_id) must be reconciled with
// whatever id space that table ends up using.
model SakhiProfile {
  id               String    @id @default(uuid()) @map("sakhi_id")
  userId           String    @unique @map("user_id")
  user             User      @relation(fields: [userId], references: [id])
  primaryProjectId String    @map("primary_project_id")
  primaryProject   Project   @relation(fields: [primaryProjectId], references: [projectId])
  supervisorId     String?   @map("supervisor_id")
  employeeCode     String?   @unique @map("employee_code") @db.VarChar(80)
  phoneNumber      String    @map("phone_number") @db.VarChar(13)
  backupContact    String?   @map("backup_contact") @db.VarChar(13)
  panToken         Bytes?    @map("pan_token")
  aadhaarToken     Bytes?    @map("aadhaar_token")
  bankAccountToken Bytes?    @map("bank_account_token")
  ifscCode         String?   @map("ifsc_code") @db.VarChar(20)
  activeFrom       DateTime  @map("active_from") @db.Date
  activeTo         DateTime? @map("active_to") @db.Date
  createdAt        DateTime  @default(now()) @map("created_at")
  createdByUserId  String?   @map("created_by_user_id")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  updatedByUserId  String?   @map("updated_by_user_id")
  isDeleted        Boolean   @default(false) @map("is_deleted")
  deletedAt        DateTime? @map("deleted_at")

  @@map("sakhi_profiles")
}

// DEPRECATED — superseded by the 7 per-level tables below (states, districts,
// blocks, phcs, sub_centres, villages, padas). Kept temporarily, unused by any
// application code, as a rollback safety net after the data backfill; slated
// for removal in a follow-up once the new tables are verified in production.
enum GeoType {
  STATE
  DISTRICT
  BLOCK
  PHC
  SUBCENTRE
  VILLAGE
  PADA
}

enum GeographyUnitStatus {
  ACTIVE
  INACTIVE
}

model GeographyUnit {
  geographyUnitId String              @id @default(uuid()) @map("geography_unit_id")
  parentId        String?             @map("parent_id")
  parent          GeographyUnit?      @relation("GeographyUnitHierarchy", fields: [parentId], references: [geographyUnitId])
  children        GeographyUnit[]     @relation("GeographyUnitHierarchy")
  geoType         GeoType             @map("geo_type")
  geoCode         String?             @map("geo_code") @db.VarChar(80)
  name            String              @db.VarChar(180)
  status          GeographyUnitStatus @default(ACTIVE)
  createdAt       DateTime            @default(now()) @map("created_at")
  createdByUserId String?             @map("created_by_user_id")
  updatedAt       DateTime            @updatedAt @map("updated_at")
  updatedByUserId String?             @map("updated_by_user_id")
  isDeleted       Boolean             @default(false) @map("is_deleted")
  deletedAt       DateTime?           @map("deleted_at")

  @@unique([parentId, geoType, geoCode])
  @@map("geography_units")
}

// Column set matches ERD Appendix A.1's legacy per-level design, scoped to the
// SRS's 7-level hierarchy only (State > District > Block > PHC > Sub-centre >
// Village > Pada) — no Taluka, no Panchayat, no many-to-many mapping tables
// (SRS treated as final over the ERD's taluka/mapping-table variant). Replaces
// the single-table GeographyUnit model above: one dedicated table per level,
// each with a direct FK to its parent level instead of a generic parent_id +
// geo_type discriminator.

enum GeographyStatus {
  ACTIVE
  INACTIVE
}

model State {
  stateId         String          @id @default(uuid()) @map("state_id")
  stateCode       String          @unique @map("state_code") @db.VarChar(80)
  name            String          @db.VarChar(180)
  status          GeographyStatus @default(ACTIVE)
  createdAt       DateTime        @default(now()) @map("created_at")
  createdByUserId String?         @map("created_by_user_id")
  updatedAt       DateTime        @updatedAt @map("updated_at")
  updatedByUserId String?         @map("updated_by_user_id")
  isDeleted       Boolean         @default(false) @map("is_deleted")
  deletedAt       DateTime?       @map("deleted_at")

  districts District[]

  @@map("states")
}

model District {
  districtId      String          @id @default(uuid()) @map("district_id")
  stateId         String          @map("state_id")
  state           State           @relation(fields: [stateId], references: [stateId], onDelete: Restrict)
  districtCode    String          @map("district_code") @db.VarChar(80)
  name            String          @db.VarChar(180)
  status          GeographyStatus @default(ACTIVE)
  createdAt       DateTime        @default(now()) @map("created_at")
  createdByUserId String?         @map("created_by_user_id")
  updatedAt       DateTime        @updatedAt @map("updated_at")
  updatedByUserId String?         @map("updated_by_user_id")
  isDeleted       Boolean         @default(false) @map("is_deleted")
  deletedAt       DateTime?       @map("deleted_at")

  blocks Block[]

  @@unique([stateId, districtCode])
  @@map("districts")
}

model Block {
  blockId         String          @id @default(uuid()) @map("block_id")
  districtId      String          @map("district_id")
  district        District        @relation(fields: [districtId], references: [districtId], onDelete: Restrict)
  blockCode       String          @map("block_code") @db.VarChar(80)
  name            String          @db.VarChar(180)
  status          GeographyStatus @default(ACTIVE)
  createdAt       DateTime        @default(now()) @map("created_at")
  createdByUserId String?         @map("created_by_user_id")
  updatedAt       DateTime        @updatedAt @map("updated_at")
  updatedByUserId String?         @map("updated_by_user_id")
  isDeleted       Boolean         @default(false) @map("is_deleted")
  deletedAt       DateTime?       @map("deleted_at")

  phcs Phc[]

  @@unique([districtId, blockCode])
  @@map("blocks")
}

model Phc {
  phcId           String          @id @default(uuid()) @map("phc_id")
  blockId         String          @map("block_id")
  block           Block           @relation(fields: [blockId], references: [blockId], onDelete: Restrict)
  phcCode         String          @map("phc_code") @db.VarChar(80)
  name            String          @db.VarChar(180)
  status          GeographyStatus @default(ACTIVE)
  createdAt       DateTime        @default(now()) @map("created_at")
  createdByUserId String?         @map("created_by_user_id")
  updatedAt       DateTime        @updatedAt @map("updated_at")
  updatedByUserId String?         @map("updated_by_user_id")
  isDeleted       Boolean         @default(false) @map("is_deleted")
  deletedAt       DateTime?       @map("deleted_at")

  subCentres SubCentre[]

  @@unique([blockId, phcCode])
  @@map("phcs")
}

model SubCentre {
  subCentreId     String          @id @default(uuid()) @map("sub_centre_id")
  phcId           String          @map("phc_id")
  phc             Phc             @relation(fields: [phcId], references: [phcId], onDelete: Restrict)
  subCentreCode   String          @map("sub_centre_code") @db.VarChar(80)
  name            String          @db.VarChar(180)
  status          GeographyStatus @default(ACTIVE)
  createdAt       DateTime        @default(now()) @map("created_at")
  createdByUserId String?         @map("created_by_user_id")
  updatedAt       DateTime        @updatedAt @map("updated_at")
  updatedByUserId String?         @map("updated_by_user_id")
  isDeleted       Boolean         @default(false) @map("is_deleted")
  deletedAt       DateTime?       @map("deleted_at")

  villages Village[]

  @@unique([phcId, subCentreCode])
  @@map("sub_centres")
}

model Village {
  villageId       String          @id @default(uuid()) @map("village_id")
  subCentreId     String          @map("sub_centre_id")
  subCentre       SubCentre       @relation(fields: [subCentreId], references: [subCentreId], onDelete: Restrict)
  villageCode     String          @map("village_code") @db.VarChar(80)
  name            String          @db.VarChar(180)
  status          GeographyStatus @default(ACTIVE)
  createdAt       DateTime        @default(now()) @map("created_at")
  createdByUserId String?         @map("created_by_user_id")
  updatedAt       DateTime        @updatedAt @map("updated_at")
  updatedByUserId String?         @map("updated_by_user_id")
  isDeleted       Boolean         @default(false) @map("is_deleted")
  deletedAt       DateTime?       @map("deleted_at")

  padas Pada[]

  @@unique([subCentreId, villageCode])
  @@map("villages")
}

model Pada {
  padaId          String          @id @default(uuid()) @map("pada_id")
  villageId       String          @map("village_id")
  village         Village         @relation(fields: [villageId], references: [villageId], onDelete: Restrict)
  padaCode        String          @map("pada_code") @db.VarChar(80)
  name            String          @db.VarChar(180)
  status          GeographyStatus @default(ACTIVE)
  createdAt       DateTime        @default(now()) @map("created_at")
  createdByUserId String?         @map("created_by_user_id")
  updatedAt       DateTime        @updatedAt @map("updated_at")
  updatedByUserId String?         @map("updated_by_user_id")
  isDeleted       Boolean         @default(false) @map("is_deleted")
  deletedAt       DateTime?       @map("deleted_at")

  @@unique([villageId, padaCode])
  @@map("padas")
}

// Flat app-wide configuration key/value store — NOT a dropdown/reference list
// (see LookupCategory/LookupValue below for that). Holds only non-sensitive,
// non-business-rule display/behavior config the mobile apps cache locally
// (e.g. a sync interval, minimum supported app version, a feature-flag
// toggle, a max upload size). Business thresholds/rates/incentive figures
// belong in GoRules/rules-service, never here, and this must never hold
// secrets/credentials (root .claude/CLAUDE.md §9). Deliberately no
// category/hierarchy — one key maps to one string value.
model ApplicationParameter {
  id              String   @id @default(uuid()) @map("application_parameter_id")
  paramKey        String   @unique @map("param_key") @db.VarChar(100)
  paramValue      String   @map("param_value") @db.VarChar(500)
  description     String?
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  createdByUserId String?  @map("created_by_user_id")
  updatedAt       DateTime @updatedAt @map("updated_at")
  updatedByUserId String?  @map("updated_by_user_id")

  @@map("application_parameters")
}

// Column set matches ERD's lookup_categories/lookup_values tables. All
// dropdown/select/radio options used in approved forms are maintained here
// with a stable value_code, display label, and sort_order — form_versions'
// schema_json stores a published snapshot for offline rendering, but this
// stays the live managed master (see ERD note after lookup_values).
model LookupCategory {
  id              String   @id @default(uuid()) @map("lookup_category_id")
  categoryCode    String   @unique @map("category_code") @db.VarChar(80)
  categoryName    String   @map("category_name") @db.VarChar(160)
  description     String?
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  createdByUserId String?  @map("created_by_user_id")
  updatedAt       DateTime @updatedAt @map("updated_at")
  updatedByUserId String?  @map("updated_by_user_id")

  values LookupValue[]

  @@map("lookup_categories")
}

model LookupValue {
  id                  String         @id @default(uuid()) @map("lookup_value_id")
  lookupCategoryId    String         @map("lookup_category_id")
  category            LookupCategory @relation(fields: [lookupCategoryId], references: [id])
  valueCode           String         @map("value_code") @db.VarChar(80)
  valueLabel          String         @map("value_label") @db.VarChar(160)
  sortOrder           Int            @default(0) @map("sort_order")
  // Self-relation for dependent dropdowns (e.g. District depends on State) —
  // the parent must belong to the same category; enforced in the service
  // layer since Prisma can't express a same-table cross-row column check.
  parentLookupValueId String?        @map("parent_lookup_value_id")
  parent              LookupValue?   @relation("LookupValueHierarchy", fields: [parentLookupValueId], references: [id])
  children            LookupValue[]  @relation("LookupValueHierarchy")
  isActive            Boolean        @default(true) @map("is_active")
  createdAt           DateTime       @default(now()) @map("created_at")
  createdByUserId     String?        @map("created_by_user_id")
  updatedAt           DateTime       @updatedAt @map("updated_at")
  updatedByUserId     String?        @map("updated_by_user_id")

  @@unique([lookupCategoryId, valueCode])
  @@map("lookup_values")
}

// ---------------------------------------------------------------------------
// ERD "Access, Project, and Geography" (§4.1) tables previously unmodeled.
// All FK columns point at tables auth-service owns (users, projects,
// geography_units, sakhi_profiles, funders, lookup_values), but — matching the
// existing convention in this file (UserRole.geographyUnitId,
// SakhiProfile.supervisorId) — they are kept as plain scalar columns with an
// explanatory comment rather than declared as Prisma @relation edges, until a
// query actually needs the join. This avoids adding reverse-relation arrays to
// the six existing models purely for referential decoration.
// ---------------------------------------------------------------------------

// supervisor_profiles — ERD Appendix A (§4.1). Referenced by
// SakhiProfile.supervisorId (above) and, later, supervisor-operations tables.
model SupervisorProfile {
  id              String    @id @default(uuid()) @map("supervisor_id")
  // users.user_id — same schema, kept scalar per this file's convention.
  userId          String    @unique @map("user_id")
  managerUserId   String?   @map("manager_user_id")
  // geography_units.geography_unit_id — the supervisor's geography scope.
  geographyUnitId String?   @map("geography_unit_id")
  activeFrom      DateTime  @map("active_from") @db.Date
  activeTo        DateTime? @map("active_to") @db.Date
  createdAt       DateTime  @default(now()) @map("created_at")
  createdByUserId String?   @map("created_by_user_id")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  updatedByUserId String?   @map("updated_by_user_id")
  isDeleted       Boolean   @default(false) @map("is_deleted")
  deletedAt       DateTime? @map("deleted_at")

  @@map("supervisor_profiles")
}

enum DevicePlatform {
  ANDROID
  WEB
}

// ERD device_registry.status text is malformed ("REPLACED,PAUSED BLOCKED,Inactive");
// normalized here to the intended six-value set.
enum DeviceStatus {
  ACTIVE
  LOST
  REPLACED
  PAUSED
  BLOCKED
  INACTIVE
}

// device_registry — ERD Appendix A (§4.1). Referenced by user_sessions.device_id
// (kept scalar there) and sync_batches (owned by sync-service).
model DeviceRegistry {
  id              String         @id @default(uuid()) @map("device_id")
  // users.user_id — same schema, kept scalar per convention.
  userId          String         @map("user_id")
  deviceUuid      String         @unique @map("device_uuid") @db.VarChar(128)
  platform        DevicePlatform
  osVersion       String?        @map("os_version") @db.VarChar(60)
  appVersion      String?        @map("app_version") @db.VarChar(40)
  lastSyncAt      DateTime?      @map("last_sync_at")
  status          DeviceStatus   @default(ACTIVE)
  createdAt       DateTime       @default(now()) @map("created_at")
  createdByUserId String?        @map("created_by_user_id")
  updatedAt       DateTime       @updatedAt @map("updated_at")
  updatedByUserId String?        @map("updated_by_user_id")
  isDeleted       Boolean        @default(false) @map("is_deleted")
  deletedAt       DateTime?      @map("deleted_at")

  @@map("device_registry")
}

// project_geographies — ERD Appendix A (§4.1). Maps projects to geography units.
model ProjectGeography {
  id              String    @id @default(uuid()) @map("project_geo_id")
  // projects.project_id / geography_units.geography_unit_id — same schema, scalar.
  projectId       String    @map("project_id")
  geographyUnitId String    @map("geography_unit_id")
  activeFrom      DateTime  @map("active_from") @db.Date
  activeTo        DateTime? @map("active_to") @db.Date
  createdAt       DateTime  @default(now()) @map("created_at")
  createdByUserId String?   @map("created_by_user_id")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  updatedByUserId String?   @map("updated_by_user_id")
  isDeleted       Boolean   @default(false) @map("is_deleted")
  deletedAt       DateTime? @map("deleted_at")

  @@map("project_geographies")
}

enum TargetPeriodType {
  MONTHLY
  QUARTERLY
  ANNUAL
  PROJECT_PERIOD
}

// project_registration_targets — ERD §4.1 (merged canonical definition). Per the
// ERD's own merge note, keeps case_type_lookup_id / registration_target /
// status_lookup_id (not the discarded beneficiary_type / registration_target_count
// / status ENUM variants). The ERD's merged definition intentionally has NO
// is_deleted/deleted_at columns — followed here rather than force-standardized.
model ProjectRegistrationTarget {
  id                 String            @id @default(uuid()) @map("target_id")
  // funders.funder_id / projects.project_id / geography_units.geography_unit_id /
  // lookup_values.lookup_value_id — all same schema, kept scalar per convention.
  funderId           String?           @map("funder_id")
  projectId          String            @map("project_id")
  // NULL means a project-level (not geography-scoped) target.
  geographyUnitId    String?           @map("geography_unit_id")
  // NULL means a combined Mother+Child target (not split by case type).
  caseTypeLookupId   String?           @map("case_type_lookup_id")
  targetPeriodType   TargetPeriodType? @map("target_period_type")
  targetPeriodStart  DateTime          @map("target_period_start") @db.Date
  targetPeriodEnd    DateTime          @map("target_period_end") @db.Date
  registrationTarget Int?              @map("registration_target")
  statusLookupId     String?           @map("status_lookup_id")
  createdAt          DateTime          @default(now()) @map("created_at")
  createdByUserId    String?           @map("created_by_user_id")
  updatedAt          DateTime          @updatedAt @map("updated_at")
  updatedByUserId    String?           @map("updated_by_user_id")

  @@map("project_registration_targets")
}

// sakhi_registration_targets — NOT in the ERD/HLD/SRS. ProjectRegistrationTarget
// above is project-grain only (no sakhiId); the reference Android app's
// "Beneficiary/Master Data Download" screen needs a per-Sakhi target for
// offline reference, so this is a genuinely new model at Sakhi grain, added
// for that endpoint. Follows this file's ProjectRegistrationTarget as the
// closest existing convention, but (unlike it) keeps the isDeleted/deletedAt
// soft-delete columns, matching the rest of this schema's default (see root
// .claude/CLAUDE.md §11) rather than ProjectRegistrationTarget's documented
// ERD-merge exception.
model SakhiRegistrationTarget {
  id                 String    @id @default(uuid()) @map("sakhi_registration_target_id")
  sakhiId            String    @map("sakhi_id")
  projectId          String    @map("project_id")
  targetPeriodStart  DateTime  @map("target_period_start") @db.Date
  targetPeriodEnd    DateTime  @map("target_period_end") @db.Date
  registrationTarget Int?      @map("registration_target")
  createdAt          DateTime  @default(now()) @map("created_at")
  createdByUserId    String?   @map("created_by_user_id")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  updatedByUserId    String?   @map("updated_by_user_id")
  isDeleted          Boolean   @default(false) @map("is_deleted")
  deletedAt          DateTime? @map("deleted_at")

  @@map("sakhi_registration_targets")
}

enum SakhiAssignmentType {
  PRIMARY
  SECONDARY
  TEMPORARY_COVERAGE
  PAUSED
  STOPPED
}

// sakhi_assignments — ERD Appendix A (§4.1). A Sakhi's project + geography scope.
model SakhiAssignment {
  id              String              @id @default(uuid()) @map("assignment_id")
  // sakhi_profiles.sakhi_id / projects.project_id / geography_units.geography_unit_id.
  sakhiId         String              @map("sakhi_id")
  projectId       String              @map("project_id")
  geographyUnitId String              @map("geography_unit_id")
  assignmentType  SakhiAssignmentType @default(PRIMARY) @map("assignment_type")
  activeFrom      DateTime            @map("active_from") @db.Date
  activeTo        DateTime?           @map("active_to") @db.Date
  createdAt       DateTime            @default(now()) @map("created_at")
  createdByUserId String?             @map("created_by_user_id")
  updatedAt       DateTime            @updatedAt @map("updated_at")
  updatedByUserId String?             @map("updated_by_user_id")
  isDeleted       Boolean             @default(false) @map("is_deleted")
  deletedAt       DateTime?           @map("deleted_at")

  // ERD §6 "Required Indexes and Constraints" calls for this composite index.
  @@index([sakhiId, projectId, geographyUnitId, activeTo])
  @@map("sakhi_assignments")
}

// sakhi_location_assignments — ERD (§4.1 geography cluster). Assigns a Sakhi to a
// village (and optional pada). NOTE: the ERD FKs village_id -> villages and
// pada_id -> padas, but this codebase models villages/padas as geography_units
// rows (geoType VILLAGE / PADA) — there are no separate villages/padas tables.
// So both columns are geography_units.geography_unit_id references (scalar), and
// the geoType is expected to be VILLAGE / PADA respectively. The ERD gives this
// table no audit columns; kept minimal to match the ERD.
model SakhiLocationAssignment {
  id             String    @id @default(uuid()) @map("sakhi_location_assignment_id")
  sakhiId        String    @map("sakhi_id")
  projectId      String    @map("project_id")
  // geography_units.geography_unit_id with geoType VILLAGE.
  villageId      String    @map("village_id")
  // geography_units.geography_unit_id with geoType PADA (optional / hamlet level).
  padaId         String?   @map("pada_id")
  effectiveFrom  DateTime  @map("effective_from") @db.Date
  effectiveTo    DateTime? @map("effective_to") @db.Date
  statusLookupId String?   @map("status_lookup_id")

  @@map("sakhi_location_assignments")
}
