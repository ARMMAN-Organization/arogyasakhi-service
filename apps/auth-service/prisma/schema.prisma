generator client {
  provider        = "prisma-client-js"
  output          = "../../../node_modules/.prisma/client-auth-service"
  previewFeatures = ["multiSchema"]
}

// schemas is set explicitly (rather than relying on the connection URL's
// ?schema= param) because Supabase's transaction pooler (port 6543, used for
// DATABASE_URL at runtime) does not honor per-session search_path changes —
// confirmed live: `show search_path` stays "public" over the pooler even with
// ?schema=auth_service in the URL, but correctly becomes "auth_service" over
// the session pooler (port 5432, used only for DIRECT_URL/migrations). Baking
// the schema into every generated query via @@schema(...) works regardless of
// which pooler mode is used.
datasource db {
  provider  = "postgresql"
  directUrl = env("DIRECT_URL")
  url       = env("DATABASE_URL")
  schemas   = ["auth_service"]
}

// auth-service owns these tables only (forklift rule).
// Field/table definitions sourced from docs/Arogya_Sakhi_Database_Design_ERD_Table_Definitions.docx.md
// section "users", "roles", "user_roles", "user_sessions" (Appendix A.1).
// project_id / geography_unit_id / device_id are plain scalar columns, not Prisma
// relations, because projects/geography_units/device_registry are owned by other
// services (no cross-service joins per the forklift rule).

enum UserStatus {
  ACTIVE
  INACTIVE
  LOCKED
  PAUSED
  DELETED

  @@schema("auth_service")
}

enum UserRoleStatus {
  ACTIVE
  EXPIRED
  REVOKED
  INACTIVE

  @@schema("auth_service")
}

model User {
  id                String     @id @default(uuid()) @map("user_id")
  // Contact/identity field per the ERD's users table — no longer a login
  // credential; login is username + password only, for every role.
  mobileNumber      String     @unique @map("mobile_number") @db.VarChar(13)
  // Sole login identifier per SRS FR-S-1.1 ("Sakhi must authenticate using
  // Username and password"), applied to every role rather than SAKHI only.
  // Not in the ERD's users table — added because the SRS is authoritative
  // over the ERD/HLD for this project. Required and unique.
  username          String     @unique @db.VarChar(50)
  passwordHash      String     @map("password_hash") @db.VarChar(255)
  displayName       String     @map("display_name") @db.VarChar(160)
  email             String?    @unique @db.VarChar(254)
  status            UserStatus @default(ACTIVE)
  lastLoginAt       DateTime?  @map("last_login_at")
  failedLoginCount  Int        @default(0) @map("failed_login_count")
  passwordChangedAt DateTime?  @map("password_changed_at")
  createdAt         DateTime   @default(now()) @map("created_at")
  createdByUserId   String?    @map("created_by_user_id")
  updatedAt         DateTime   @updatedAt @map("updated_at")
  updatedByUserId   String?    @map("updated_by_user_id")
  isDeleted         Boolean    @default(false) @map("is_deleted")
  deletedAt         DateTime?  @map("deleted_at")

  userRoles    UserRole[]
  userSessions UserSession[]
  sakhiProfile SakhiProfile?

  @@map("users")
  @@schema("auth_service")
}

model Role {
  id              String    @id @default(uuid()) @map("role_id")
  roleCode        String    @unique @map("role_code") @db.VarChar(50)
  roleName        String    @map("role_name") @db.VarChar(120)
  description     String?
  isActive        Boolean   @default(true) @map("is_active")
  createdAt       DateTime  @default(now()) @map("created_at")
  createdByUserId String?   @map("created_by_user_id")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  updatedByUserId String?   @map("updated_by_user_id")
  isDeleted       Boolean   @default(false) @map("is_deleted")
  deletedAt       DateTime? @map("deleted_at")

  userRoles UserRole[]

  @@map("roles")
  @@schema("auth_service")
}

model UserRole {
  id        String         @id @default(uuid()) @map("user_role_id")
  userId    String         @map("user_id")
  roleId    String         @map("role_id")
  // projects live in this same schema (auth-service also owns project/funder
  // master data — see the Funder/Project models below), so this is a real
  // Prisma relation, not a cross-service scalar.
  projectId String?        @map("project_id")
  project   Project?       @relation(fields: [projectId], references: [projectId])
  // geography_units.geography_unit_id — same schema too, but no relation is
  // declared here yet; left as a plain scalar until a caller actually needs it.
  geographyUnitId String?        @map("geography_unit_id")
  effectiveFrom   DateTime       @map("effective_from")
  effectiveTo     DateTime?      @map("effective_to")
  status          UserRoleStatus @default(ACTIVE)
  createdAt       DateTime       @default(now()) @map("created_at")
  createdByUserId String?        @map("created_by_user_id")
  updatedAt       DateTime       @updatedAt @map("updated_at")
  updatedByUserId String?        @map("updated_by_user_id")
  isDeleted       Boolean        @default(false) @map("is_deleted")
  deletedAt       DateTime?      @map("deleted_at")

  user User @relation(fields: [userId], references: [id])
  role Role @relation(fields: [roleId], references: [id])

  @@map("user_roles")
  @@schema("auth_service")
}

model UserSession {
  id               String    @id @default(uuid()) @map("session_id")
  userId           String    @map("user_id")
  refreshTokenHash String    @unique @map("refresh_token_hash") @db.VarChar(255)
  // device_registry.device_id — deferred; not modeled yet per current scope.
  deviceId         String?   @map("device_id")
  issuedAt         DateTime  @map("issued_at")
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")
  ipAddress        String?   @map("ip_address") @db.VarChar(45)
  createdAt        DateTime  @default(now()) @map("created_at")
  createdByUserId  String?   @map("created_by_user_id")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  updatedByUserId  String?   @map("updated_by_user_id")
  isDeleted        Boolean   @default(false) @map("is_deleted")
  deletedAt        DateTime? @map("deleted_at")

  user User @relation(fields: [userId], references: [id])

  @@map("user_sessions")
  @@schema("auth_service")
}

// Column set matches ERD Appendix A.1 (funders, projects) exactly.

enum FunderStatus {
  ACTIVE
  INACTIVE

  @@schema("auth_service")
}

model Funder {
  funderId        String       @id @default(uuid()) @map("funder_id")
  funderCode      String       @unique @map("funder_code") @db.VarChar(50)
  funderName      String       @map("funder_name") @db.VarChar(40)
  status          FunderStatus @default(ACTIVE)
  createdAt       DateTime     @default(now()) @map("created_at")
  createdByUserId String?      @map("created_by_user_id")
  updatedAt       DateTime     @updatedAt @map("updated_at")
  updatedByUserId String?      @map("updated_by_user_id")
  isDeleted       Boolean      @default(false) @map("is_deleted")
  deletedAt       DateTime?    @map("deleted_at")

  projects Project[]

  @@map("funders")
  @@schema("auth_service")
}

enum ProjectStatus {
  ACTIVE
  PAUSED
  CLOSED

  @@schema("auth_service")
}

model Project {
  projectId       String        @id @default(uuid()) @map("project_id")
  funderId        String?       @map("funder_id")
  funder          Funder?       @relation(fields: [funderId], references: [funderId])
  projectCode     String        @unique @map("project_code") @db.VarChar(80)
  projectName     String        @map("project_name") @db.VarChar(80)
  financialYear   String        @map("financial_year") @db.VarChar(9)
  startDate       DateTime      @map("start_date") @db.Date
  endDate         DateTime?     @map("end_date") @db.Date
  status          ProjectStatus @default(ACTIVE)
  createdAt       DateTime      @default(now()) @map("created_at")
  createdByUserId String?       @map("created_by_user_id")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  updatedByUserId String?       @map("updated_by_user_id")
  isDeleted       Boolean       @default(false) @map("is_deleted")
  deletedAt       DateTime?     @map("deleted_at")

  userRoles     UserRole[]
  sakhiProfiles SakhiProfile[]

  @@map("projects")
  @@schema("auth_service")
}

// Column set matches ERD Appendix A.1 ("sakhi_profiles") exactly.
// supervisorId references supervisor_profiles.supervisor_id, which is not
// modeled anywhere yet — left as a plain scalar (no relation) rather than
// invented.
model SakhiProfile {
  id               String    @id @default(uuid()) @map("sakhi_id")
  userId           String    @unique @map("user_id")
  user             User      @relation(fields: [userId], references: [id])
  primaryProjectId String    @map("primary_project_id")
  primaryProject   Project   @relation(fields: [primaryProjectId], references: [projectId])
  supervisorId     String?   @map("supervisor_id")
  employeeCode     String?   @unique @map("employee_code") @db.VarChar(80)
  phoneNumber      String    @map("phone_number") @db.VarChar(13)
  backupContact    String?   @map("backup_contact") @db.VarChar(13)
  panToken         Bytes?    @map("pan_token")
  aadhaarToken     Bytes?    @map("aadhaar_token")
  bankAccountToken Bytes?    @map("bank_account_token")
  ifscCode         String?   @map("ifsc_code") @db.VarChar(20)
  activeFrom       DateTime  @map("active_from") @db.Date
  activeTo         DateTime? @map("active_to") @db.Date
  createdAt        DateTime  @default(now()) @map("created_at")
  createdByUserId  String?   @map("created_by_user_id")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  updatedByUserId  String?   @map("updated_by_user_id")
  isDeleted        Boolean   @default(false) @map("is_deleted")
  deletedAt        DateTime? @map("deleted_at")

  @@map("sakhi_profiles")
  @@schema("auth_service")
}

// Column set matches ERD Appendix A.1 (geography_units) exactly. Scoped to the
// SRS's 7-level hierarchy only (State > District > Block > PHC > Sub-centre >
// Village > Pada) — no Taluka, no Panchayat (SRS treated as final over the
// ERD's alternate, per-level table design).

enum GeoType {
  STATE
  DISTRICT
  BLOCK
  PHC
  SUBCENTRE
  VILLAGE
  PADA

  @@schema("auth_service")
}

enum GeographyUnitStatus {
  ACTIVE
  INACTIVE

  @@schema("auth_service")
}

model GeographyUnit {
  geographyUnitId String              @id @default(uuid()) @map("geography_unit_id")
  parentId        String?             @map("parent_id")
  parent          GeographyUnit?      @relation("GeographyUnitHierarchy", fields: [parentId], references: [geographyUnitId])
  children        GeographyUnit[]     @relation("GeographyUnitHierarchy")
  geoType         GeoType             @map("geo_type")
  geoCode         String?             @map("geo_code") @db.VarChar(80)
  name            String              @db.VarChar(180)
  status          GeographyUnitStatus @default(ACTIVE)
  createdAt       DateTime            @default(now()) @map("created_at")
  createdByUserId String?             @map("created_by_user_id")
  updatedAt       DateTime            @updatedAt @map("updated_at")
  updatedByUserId String?             @map("updated_by_user_id")
  isDeleted       Boolean             @default(false) @map("is_deleted")
  deletedAt       DateTime?           @map("deleted_at")

  @@unique([parentId, geoType, geoCode])
  @@map("geography_units")
  @@schema("auth_service")
}
