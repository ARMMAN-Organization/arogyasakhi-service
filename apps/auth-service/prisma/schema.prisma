generator client {
  provider        = "prisma-client-js"
  output          = "../../../node_modules/.prisma/client-auth-service"
  previewFeatures = ["multiSchema"]
}

// schemas is set explicitly (rather than relying on the connection URL's
// ?schema= param) because Supabase's transaction pooler (port 6543, used for
// DATABASE_URL at runtime) does not honor per-session search_path changes —
// confirmed live: `show search_path` stays "public" over the pooler even with
// ?schema=auth_service in the URL, but correctly becomes "auth_service" over
// the session pooler (port 5432, used only for DIRECT_URL/migrations). Baking
// the schema into every generated query via @@schema(...) works regardless of
// which pooler mode is used.
datasource db {
  provider  = "postgresql"
  directUrl = env("DIRECT_URL")
  url       = env("DATABASE_URL")
  schemas   = ["auth_service"]
}

// auth-service owns these tables only (forklift rule).
// Field/table definitions sourced from docs/Arogya_Sakhi_Database_Design_ERD_Table_Definitions.docx.md
// section "users", "roles", "user_roles", "user_sessions" (Appendix A.1).
// project_id / geography_unit_id / device_id are plain scalar columns, not Prisma
// relations, because projects/geography_units/device_registry are owned by other
// services (no cross-service joins per the forklift rule).

enum UserStatus {
  ACTIVE
  INACTIVE
  LOCKED
  PAUSED
  DELETED

  @@schema("auth_service")
}

enum UserRoleStatus {
  ACTIVE
  EXPIRED
  REVOKED
  INACTIVE

  @@schema("auth_service")
}

model User {
  id                String     @id @default(uuid()) @map("user_id")
  // Contact/identity field per the ERD's users table — no longer a login
  // credential; login is username + password only, for every role.
  mobileNumber      String     @unique @map("mobile_number") @db.VarChar(13)
  // Sole login identifier per SRS FR-S-1.1 ("Sakhi must authenticate using
  // Username and password"), applied to every role rather than SAKHI only.
  // Not in the ERD's users table — added because the SRS is authoritative
  // over the ERD/HLD for this project. Required and unique.
  username          String     @unique @db.VarChar(50)
  passwordHash      String     @map("password_hash") @db.VarChar(255)
  displayName       String     @map("display_name") @db.VarChar(160)
  email             String?    @unique @db.VarChar(254)
  status            UserStatus @default(ACTIVE)
  lastLoginAt       DateTime?  @map("last_login_at")
  failedLoginCount  Int        @default(0) @map("failed_login_count")
  passwordChangedAt DateTime?  @map("password_changed_at")
  createdAt         DateTime   @default(now()) @map("created_at")
  createdByUserId   String?    @map("created_by_user_id")
  updatedAt         DateTime   @updatedAt @map("updated_at")
  updatedByUserId   String?    @map("updated_by_user_id")
  isDeleted         Boolean    @default(false) @map("is_deleted")
  deletedAt         DateTime?  @map("deleted_at")

  userRoles    UserRole[]
  userSessions UserSession[]

  @@map("users")
  @@schema("auth_service")
}

model Role {
  id              String    @id @default(uuid()) @map("role_id")
  roleCode        String    @unique @map("role_code") @db.VarChar(50)
  roleName        String    @map("role_name") @db.VarChar(120)
  description     String?
  isActive        Boolean   @default(true) @map("is_active")
  createdAt       DateTime  @default(now()) @map("created_at")
  createdByUserId String?   @map("created_by_user_id")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  updatedByUserId String?   @map("updated_by_user_id")
  isDeleted       Boolean   @default(false) @map("is_deleted")
  deletedAt       DateTime? @map("deleted_at")

  userRoles UserRole[]

  @@map("roles")
  @@schema("auth_service")
}

model UserRole {
  id              String         @id @default(uuid()) @map("user_role_id")
  userId          String         @map("user_id")
  roleId          String         @map("role_id")
  // projects.project_id — owned by another service, no cross-service relation.
  projectId       String?        @map("project_id")
  // geography_units.geography_unit_id — owned by another service, no cross-service relation.
  geographyUnitId String?        @map("geography_unit_id")
  effectiveFrom   DateTime       @map("effective_from")
  effectiveTo     DateTime?      @map("effective_to")
  status          UserRoleStatus @default(ACTIVE)
  createdAt       DateTime       @default(now()) @map("created_at")
  createdByUserId String?        @map("created_by_user_id")
  updatedAt       DateTime       @updatedAt @map("updated_at")
  updatedByUserId String?        @map("updated_by_user_id")
  isDeleted       Boolean        @default(false) @map("is_deleted")
  deletedAt       DateTime?      @map("deleted_at")

  user User @relation(fields: [userId], references: [id])
  role Role @relation(fields: [roleId], references: [id])

  @@map("user_roles")
  @@schema("auth_service")
}

model UserSession {
  id               String    @id @default(uuid()) @map("session_id")
  userId           String    @map("user_id")
  refreshTokenHash String    @unique @map("refresh_token_hash") @db.VarChar(255)
  // device_registry.device_id — deferred; not modeled yet per current scope.
  deviceId         String?   @map("device_id")
  issuedAt         DateTime  @map("issued_at")
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")
  ipAddress        String?   @map("ip_address") @db.VarChar(45)
  createdAt        DateTime  @default(now()) @map("created_at")
  createdByUserId  String?   @map("created_by_user_id")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  updatedByUserId  String?   @map("updated_by_user_id")
  isDeleted        Boolean   @default(false) @map("is_deleted")
  deletedAt        DateTime? @map("deleted_at")

  user User @relation(fields: [userId], references: [id])

  @@map("user_sessions")
  @@schema("auth_service")
}

// Column set matches ERD Appendix A.1 (funders, projects) exactly.

enum FunderStatus {
  ACTIVE
  INACTIVE

  @@schema("auth_service")
}

model Funder {
  funderId        String       @id @default(uuid()) @map("funder_id")
  funderCode      String       @unique @map("funder_code") @db.VarChar(50)
  funderName      String       @map("funder_name") @db.VarChar(40)
  status          FunderStatus @default(ACTIVE)
  createdAt       DateTime     @default(now()) @map("created_at")
  createdByUserId String?      @map("created_by_user_id")
  updatedAt       DateTime     @updatedAt @map("updated_at")
  updatedByUserId String?      @map("updated_by_user_id")
  isDeleted       Boolean      @default(false) @map("is_deleted")
  deletedAt       DateTime?    @map("deleted_at")

  projects Project[]

  @@map("funders")
  @@schema("auth_service")
}

enum ProjectStatus {
  ACTIVE
  PAUSED
  CLOSED

  @@schema("auth_service")
}

model Project {
  projectId       String        @id @default(uuid()) @map("project_id")
  funderId        String?       @map("funder_id")
  funder          Funder?       @relation(fields: [funderId], references: [funderId])
  projectCode     String        @unique @map("project_code") @db.VarChar(80)
  projectName     String        @map("project_name") @db.VarChar(80)
  financialYear   String        @map("financial_year") @db.VarChar(9)
  startDate       DateTime      @map("start_date") @db.Date
  endDate         DateTime?     @map("end_date") @db.Date
  status          ProjectStatus @default(ACTIVE)
  createdAt       DateTime      @default(now()) @map("created_at")
  createdByUserId String?       @map("created_by_user_id")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  updatedByUserId String?       @map("updated_by_user_id")
  isDeleted       Boolean       @default(false) @map("is_deleted")
  deletedAt       DateTime?     @map("deleted_at")

  @@map("projects")
  @@schema("auth_service")
}
