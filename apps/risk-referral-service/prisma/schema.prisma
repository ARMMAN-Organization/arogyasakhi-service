generator client {
  provider = "prisma-client-js"
  output   = "../../../node_modules/.prisma/client-risk-referral-service"
}

datasource db {
  provider = "postgresql"
  directUrl = env("DIRECT_URL")
  url      = env("DATABASE_URL")
}

// risk-referral-service owns these tables only (forklift rule).
model Referral {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("referrals")
}
