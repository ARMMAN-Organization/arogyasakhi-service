NODE_ENV=development
PORT=3005
LOG_LEVEL=debug
DATABASE_URL=postgresql://postgres.PROJECT_REF:REPLACE_ME@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres
DIRECT_URL=postgresql://postgres.PROJECT_REF:REPLACE_ME@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres
CORS_ORIGINS=http://localhost:5173
# Comma-separated public URLs for the Swagger "Servers" dropdown, e.g.
# https://staging-api.example.com,https://api.example.com. Leave empty in
# local dev to fall back to http://localhost:$PORT.
PUBLIC_BASE_URLS=
API_GATEWAY_BASE_URL=http://localhost:3000

# Optional — seeds one demo ACCOMPANIED_REFERRAL and one demo REFERRAL_INCOMPLETE
# Quick Response card (prisma/seed.ts). Unset → those seed steps log "skipped". See
# the root .env.example for what each var is and why (a real beneficiary/Sakhi id
# and a SAKHI/SUPERVISOR bearer token).
SEED_DEMO_BENEFICIARY_ID=
SEED_DEMO_SAKHI_USER_ID=
SEED_DEMO_AUTH_TOKEN=

# Client-credentials identity (see auth-service's SERVICE_ACCOUNTS var) this
# service's overdue-follow-up job authenticates as, to call the
# ADMIN/SYSTEM-only POST /escalation-events and POST /notifications.
# Optional: the job logs and skips its run when unset.
SERVICE_ACCOUNT_CLIENT_ID=risk-referral-service
SERVICE_ACCOUNT_CLIENT_SECRET=
# node-cron expression for the overdue-follow-up job. Default: daily at 6am.
OVERDUE_FOLLOWUP_JOB_CRON=0 6 * * *
