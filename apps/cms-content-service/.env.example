NODE_ENV=development
PORT=3014
LOG_LEVEL=debug
DATABASE_URL=postgresql://postgres.PROJECT_REF:REPLACE_ME@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres
DIRECT_URL=postgresql://postgres.PROJECT_REF:REPLACE_ME@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres
CORS_ORIGINS=http://localhost:5173
# Comma-separated public URLs for the Swagger "Servers" dropdown, e.g.
# https://staging-api.example.com,https://api.example.com. Leave empty in
# local dev to fall back to http://localhost:$PORT.
PUBLIC_BASE_URLS=

# Learn More content sync (SRS FR-S-13.1-13.4) — manual/on-demand only via
# POST /learn-more/sync. STRAPI_BASE_URL defaults to the local Strapi
# sandbox; override in dev/staging .env to point at the hosted instance.
STRAPI_BASE_URL=http://localhost:1337
STRAPI_API_TOKEN=replace-with-a-strapi-api-token

# Shared HMAC secret used to verify that the trusted-identity headers
# (x-armman-user-id etc.) genuinely came from the API Gateway, not a
# forged direct request bypassing it — must match the gateway's own
# INTERNAL_HEADER_SECRET. Generate with e.g. `openssl rand -hex 32`.
INTERNAL_HEADER_SECRET=REPLACE_ME_WITH_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
