generator client {
  provider = "prisma-client-js"
  output   = "../../../node_modules/.prisma/client-cms-content-service"
}

datasource db {
  provider  = "postgresql"
  directUrl = env("DIRECT_URL")
  url       = env("DATABASE_URL")
}

// cms-content-service owns these tables only (forklift rule).
//
// SRS v3.0 FR-S-13.1-13.4 ("Learn More" knowledge base) and FR-S-5.2 (queued
// health education message on HR detection). Per SRS Assumptions (line 166)
// and Open Item 12 (line 601), ARMMAN has not yet delivered the real content
// structure (section names, topics, content files) — this schema is the
// "Content coming soon" placeholder shell explicitly called for in the SRS,
// not a final content model. Field names here are NOT sourced from a Strapi
// schema (none has been provided — see the ERD doc's own "Open Decisions"
// table, which flags content_sections/topics/versions field definitions as
// unresolved) — they are a minimal shape sufficient to serve a placeholder
// response and to be extended once ARMMAN provides the real structure.
enum LearnMoreMediaType {
  QNA_TEXT
  PDF
  INFOGRAPHIC
  GIF
  VIDEO
  AUDIO
}

enum LearnMoreContentStatus {
  ACTIVE
  INACTIVE
}

// FR-S-13.2: "Structure: Two-level — Sections containing Topics."
model LearnMoreSection {
  id              String                 @id @default(uuid()) @map("learn_more_section_id")
  sectionCode     String                 @unique @map("section_code") @db.VarChar(80)
  sectionName     String                 @map("section_name") @db.VarChar(160)
  sortOrder       Int                    @default(0) @map("sort_order")
  status          LearnMoreContentStatus
  createdAt       DateTime               @default(now()) @map("created_at")
  createdByUserId String?                @map("created_by_user_id")
  updatedAt       DateTime               @updatedAt @map("updated_at")
  updatedByUserId String?                @map("updated_by_user_id")
  isDeleted       Boolean                @default(false) @map("is_deleted")
  deletedAt       DateTime?              @map("deleted_at")

  topics LearnMoreTopic[]

  @@map("learn_more_sections")
}

// FR-S-13.2: "Each topic can have a different media type (QnA text, PDF,
// Infographic, GIF, Video, Audio)." contentUrl is nullable — a placeholder
// topic has no real media yet.
model LearnMoreTopic {
  id              String                 @id @default(uuid()) @map("learn_more_topic_id")
  sectionId       String                 @map("learn_more_section_id")
  topicCode       String                 @unique @map("topic_code") @db.VarChar(80)
  topicName       String                 @map("topic_name") @db.VarChar(160)
  mediaType       LearnMoreMediaType     @map("media_type")
  contentUrl      String?                @map("content_url")
  sortOrder       Int                    @default(0) @map("sort_order")
  status          LearnMoreContentStatus
  createdAt       DateTime               @default(now()) @map("created_at")
  createdByUserId String?                @map("created_by_user_id")
  updatedAt       DateTime               @updatedAt @map("updated_at")
  updatedByUserId String?                @map("updated_by_user_id")
  isDeleted       Boolean                @default(false) @map("is_deleted")
  deletedAt       DateTime?              @map("deleted_at")

  section LearnMoreSection @relation(fields: [sectionId], references: [id])

  @@map("learn_more_topics")
}

enum HealthEducationMediaType {
  TEXT
  IMAGE
  AUDIO
  VIDEO
}

// Ingested from ARMMAN's "Revised App Form Final 20.3.26 - Health
// education message.csv" (32 rows, delivered 2026-08-28) — SRS FR-S-5.2(c)
// ("queues a health education message for display"). Distinct from
// LearnMoreSection/LearnMoreTopic (FR-S-13.2's two-level Sections>Topics
// structure, still just a placeholder) — this model's shape (long body
// text, condition/stage linkage, ordered multi-message sequences per
// condition) doesn't fit that hierarchy.
//
// riskConditionId is nullable and a plain scalar with NO Prisma @relation —
// cross-service reference to risk-referral-service's risk_conditions table,
// same pattern beneficiary-service's own riskConditionId column already
// established (forklift rule: no cross-service joins). NULL on every row
// today, for two different reasons: (a) general/stage-triggered messages
// with no specific risk condition at all (e.g. Primigravida, Breastfeeding,
// Birth preparedness — about a third of the source CSV's rows), and (b) a
// structural one — risk_conditions.id is a random @default(uuid()) with no
// fixed value in that service's own seed data, so there is no stable value
// to hardcode here even for a message (e.g. "Danger Signs during
// Pregnancy") that DOES have a confirmed, real risk-condition match. The
// actual condition<->message linkage for those confirmed matches lives in
// risk-referral-service's beneficiaryRisk.service.ts CONDITION_CODE_TO_LABEL
// map, keyed by conditionCode (the one identifier stable across both
// services' independently-seeded databases) — not this column. Populating
// this column for real would need a cross-service ID-sharing scheme (e.g.
// risk_conditions seeded with fixed ids, or a lookup-by-code endpoint) that
// does not exist yet; until then, conditionCode-keyed application logic is
// the correct mechanism, not a stopgap for this column.
//
// stage is free text, copied verbatim from the CSV's Stage column — NOT an
// enum. The source data's ~15 distinct phrases ("as soon as detected during
// ANC visit", "postpartum (PP1 or PP2 whichever is attended)", "All INC
// visit", "Show this for all the ANC visits", etc.) are not a clean,
// confirmed vocabulary — inventing an enum now risks being wrong once
// ARMMAN/product later confirms the real set (explicit product decision,
// 2026-08-28).
//
// bodyMarathi is real translated content for 30 of 32 rows, ingested from
// ARMMAN's "Health education messages_Developer's copy.xlsx" (the "Message
// without media_Marathi" column) — a separate, later CSV delivery than the
// one this model's English content first came from (confirmed: that
// earlier CSV's Marathi column was empty, but this one is not). The
// remaining 2 rows (Post miscarriage/abortion/still birth, Dehydration)
// have no ARMMAN Marathi in either CSV delivery — their bodyMarathi is an
// AI-generated translation of bodyEn, not ARMMAN-sourced/reviewed content,
// pending replacement once ARMMAN delivers real translations for these two.
model HealthEducationMessage {
  id              String                   @id @default(uuid()) @map("health_education_message_id")
  // risk_conditions.risk_condition_id (risk-referral-service) — no
  // @relation, see model doc comment above. NULL for general/stage-only
  // messages.
  riskConditionId String?                  @map("risk_condition_id")
  // Verbatim from the CSV's Condition column, kept even when
  // riskConditionId is set — the CSV's own condition name may differ
  // slightly in wording from risk_conditions.conditionName, and this
  // preserves exactly what ARMMAN actually wrote, for audit/traceability.
  conditionLabel  String                   @map("condition_label") @db.VarChar(200)
  // Verbatim from the CSV's Stage column — see model doc comment.
  stage           String                   @map("stage") @db.VarChar(300)
  // The CSV's "message N" ordering within one condition's sequence (e.g.
  // Anemia: message 1 "as soon as detected", message 2 at postpartum).
  messageOrder    Int                      @map("message_order")
  titleEn         String?                  @map("title_en") @db.VarChar(200)
  bodyEn          String                   @map("body_en")
  // Real translated content on 30 of 32 seeded rows — see model doc
  // comment. The column default below is only a fallback for the 2 rows
  // (and any future row) ARMMAN's Marathi source itself left blank; it is
  // not the steady-state value for this column.
  bodyMarathi     String                   @default("Marathi content coming soon") @map("body_marathi")
  mediaType       HealthEducationMediaType @default(TEXT) @map("media_type")
  // CSV's Media file column — a bare filename/label (e.g.
  // "marathi_immunization.mp4"), not itself a resolvable URL. Treated as
  // the Strapi entry's `slug` by healthEducationMedia.syncService.ts — see
  // mediaResolvedUrl below for the actual playable URL.
  mediaFile       String?                  @map("media_file") @db.VarChar(200)
  // Absolute, playable URL for mediaFile, resolved via Strapi and stored
  // by POST /health-education/media-sync (admin-triggered, no automatic
  // schedule/webhook — same pattern as learnMore.syncService.ts). Null
  // until a sync run finds a Strapi entry whose slug matches mediaFile;
  // never guessed at or derived from mediaFile itself.
  mediaResolvedUrl String?                @map("media_resolved_url")
  sortOrder       Int                      @default(0) @map("sort_order")
  createdAt       DateTime                 @default(now()) @map("created_at")
  createdByUserId String?                  @map("created_by_user_id")
  updatedAt       DateTime                 @updatedAt @map("updated_at")
  updatedByUserId String?                  @map("updated_by_user_id")
  isDeleted       Boolean                  @default(false) @map("is_deleted")
  deletedAt       DateTime?                @map("deleted_at")

  @@unique([conditionLabel, stage, messageOrder])
  @@index([riskConditionId])
  @@map("health_education_messages")
}
