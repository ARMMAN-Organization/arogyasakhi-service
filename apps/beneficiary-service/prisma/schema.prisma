// Beneficiary domain owns these tables only (forklift rule: no cross-service tables).
generator client {
  provider = "prisma-client-js"
  output   = "../../../node_modules/.prisma/client-beneficiary-service"
}

datasource db {
  provider = "postgresql"
  directUrl = env("DIRECT_URL")
  url      = env("DATABASE_URL")
}

model BeneficiaryCase {
  id         String   @id @default(uuid())
  caseType   String   @map("case_type") // MOTHER | CHILD
  name       String
  projectId  String   @map("project_id")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("beneficiary_cases")
}
