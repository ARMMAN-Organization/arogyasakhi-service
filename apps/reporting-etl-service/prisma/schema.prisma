generator client {
  provider = "prisma-client-js"
  output   = "../../../node_modules/.prisma/client-reporting-etl-service"
}

datasource db {
  provider  = "postgresql"
  directUrl = env("DIRECT_URL")
  url       = env("DATABASE_URL")
}

// reporting-etl-service owns these Postgres tables only (forklift rule).
// Field/table definitions sourced from docs/Arogya_Sakhi_Database_Design_ERD_Table_Definitions.docx.md
// section §4.8 "Sync, Audit, ETL, and Report Export" (etl_runs, report_exports).
//
// NOTE: the ClickHouse warehouse objects (dim_*, fact_*, linelist views) in the
// same ERD section are NOT modeled here — they live in ClickHouse, not Postgres,
// and are populated by Airflow. This schema owns only the two operational
// Postgres tables that track ETL execution and report-export audit.
//
// Cross-service FK columns are plain scalars (no Prisma relation), per the
// forklift rule: user_id and all created_by/updated_by_user_id reference
// users.user_id, owned by auth-service.

enum EtlRunStatus {
  STARTED
  SUCCESS
  FAILED
  PARTIAL
}

// etl_runs — Airflow ETL run metadata (ERD §4.8).
model EtlRun {
  id              String       @id @default(uuid()) @map("etl_run_id")
  dagId           String       @map("dag_id") @db.VarChar(120)
  runStartedAt    DateTime     @map("run_started_at")
  runCompletedAt  DateTime?    @map("run_completed_at")
  sourceWatermark DateTime?    @map("source_watermark")
  targetWatermark DateTime?    @map("target_watermark")
  status          EtlRunStatus
  rowsProcessed   BigInt       @default(0) @map("rows_processed")
  errorSummary    String?      @map("error_summary")
  createdAt       DateTime     @default(now()) @map("created_at")
  createdByUserId String?      @map("created_by_user_id")
  updatedAt       DateTime     @updatedAt @map("updated_at")
  updatedByUserId String?      @map("updated_by_user_id")
  isDeleted       Boolean      @default(false) @map("is_deleted")
  deletedAt       DateTime?    @map("deleted_at")

  @@map("etl_runs")
}

// Reusable DB-backed cron-lock table for this service's own scheduled jobs
// (see libs/service-commons/src/jobs/job-lock.ts's acquireJobLock) — same
// per-service pattern as risk-referral-service/visit-form-service's own
// job_runs tables (not shared, per the forklift rule).
model JobRun {
  id          String   @id @default(uuid()) @map("job_run_id")
  jobName     String   @unique @map("job_name") @db.VarChar(80)
  lockedUntil DateTime @map("locked_until")
  lastRunAt   DateTime @map("last_run_at")

  @@map("job_runs")
}

// INTERIM store for SRS Section 9's computed app-analytics metrics
// (drop-off rate, form completion time, etc.), aggregated from
// audit-service's raw analytics_events. This is a stand-in for the
// ClickHouse warehouse the SRS actually specifies (PostgreSQL -> Airflow ->
// ClickHouse -> Metabase, per audit-service's own analytics_events comment)
// — ClickHouse/Airflow/Metabase are not provisioned anywhere in this
// codebase yet (confirmed: no docker-compose service, no client library, no
// config, repo-wide). Once that infra exists, this table's data migrates
// there and this model is retired — it is NOT a permanent addition to this
// service's Postgres-only mandate (see this file's own header comment).
model AggregatedMetric {
  id            String   @id @default(uuid()) @map("aggregated_metric_id")
  featureArea   String   @map("feature_area") @db.VarChar(60)
  metricName    String   @map("metric_name") @db.VarChar(120)
  periodStart   DateTime @map("period_start")
  periodEnd     DateTime @map("period_end")
  // Simple scalar metrics (rates, counts, average durations) land here.
  value         Decimal? @db.Decimal(18, 4)
  // Metrics that aren't a single scalar (e.g. "Topic-wise message usage" —
  // a count per topic, not one number) land here instead of `value`.
  breakdownJson Json?    @map("breakdown_json")
  computedAt    DateTime @default(now()) @map("computed_at")

  // One row per (featureArea, metricName, periodStart, periodEnd) — a
  // re-run of the aggregation job for an already-computed period upserts
  // in place rather than accumulating duplicate rows.
  @@unique([featureArea, metricName, periodStart, periodEnd])
  @@map("aggregated_metrics")
}

// report_exports — report download/export audit (ERD §4.8).
model ReportExport {
  id                String    @id @default(uuid()) @map("report_export_id")
  // users.user_id — owned by auth-service, scalar.
  userId            String    @map("user_id")
  reportCode        String    @map("report_code") @db.VarChar(100)
  filterJson        Json?     @map("filter_json")
  exportedAt        DateTime  @map("exported_at")
  fileUri           String?   @map("file_uri") @db.VarChar(512)
  rowCount          BigInt?   @map("row_count")
  downloadTimestamp DateTime  @map("download_timestamp")
  createdAt         DateTime  @default(now()) @map("created_at")
  createdByUserId   String?   @map("created_by_user_id")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  updatedByUserId   String?   @map("updated_by_user_id")
  isDeleted         Boolean   @default(false) @map("is_deleted")
  deletedAt         DateTime? @map("deleted_at")

  @@map("report_exports")
}
