NODE_ENV=development
PORT=3003
LOG_LEVEL=debug
DATABASE_URL=postgresql://postgres.PROJECT_REF:REPLACE_ME@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres
DIRECT_URL=postgresql://postgres.PROJECT_REF:REPLACE_ME@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres
CORS_ORIGINS=http://localhost:5173
# Comma-separated public URLs for the Swagger "Servers" dropdown, e.g.
# https://staging-api.example.com,https://api.example.com. Leave empty in
# local dev to fall back to http://localhost:$PORT.
PUBLIC_BASE_URLS=
# Base URL of the gateway used to reach auth-service's geography-units
# endpoint (resolving a Sakhi's geography chain for active-version). Defaults
# to http://localhost:3000 if unset.
AUTH_SERVICE_BASE_URL=
# Base URL of the gateway used to reach notification-escalation-service's
# active-transfer-window endpoint (Missed Visit Escalation TRANSFER's
# SUPERVISOR-only notMetReason gate, FR-SV-4.3). Defaults to
# http://localhost:3000 if unset.
NOTIFICATION_ESCALATION_SERVICE_BASE_URL=
# rules-service's seeded "Arogya Sakhi CCV Visit Scheduling" RuleSet id —
# needed to compute BR-13's ccvOpeningRiskState at the INC->CCV transition.
# Optional: that computation is skipped (not failed) when unset. Look it up
# via GET /api/v1/rules (ADMIN role) and match ruleSetName.
CCV_SCHEDULE_RULE_SET_ID=
# rules-service's seeded per-journey Visit Scheduling RuleSet ids — needed by
# POST /visit-schedules/generate to compute a real GoRules-driven schedule
# instead of trusting caller-supplied dates (SRS §1081/§1866: "gorules is
# mandatory for ALL... ANC/PP/NN/INC/CCV scheduling formulas"). Each is
# optional independently: a journey with no configured id here simply isn't
# available to /generate yet (400), it doesn't fail the service at boot. Look
# these up the same way as CCV_SCHEDULE_RULE_SET_ID above (match ruleSetName
# "Arogya Sakhi <ANC|PP|NN|INC|HR|Delivery Combined> Visit Scheduling").
ANC_SCHEDULE_RULE_SET_ID=
PP_SCHEDULE_RULE_SET_ID=
NN_SCHEDULE_RULE_SET_ID=
INC_SCHEDULE_RULE_SET_ID=
HR_SCHEDULE_RULE_SET_ID=
DELIVERY_SCHEDULE_RULE_SET_ID=
# rules-service's seeded ESCALATION RuleSet id (SRS §3A.2.7 FR-S-7.1), used
# by the missed-visit auto-transition job. One rule set for every
# visitFamily, unlike the per-journey ids above. Optional: the job still
# transitions OPEN->MISSED when unset, just skips escalation evaluation.
ESCALATION_RULE_SET_ID=
# Client-credentials identity (see auth-service's SERVICE_ACCOUNTS var) this
# service's missed-visit job authenticates as, to call the ADMIN/SYSTEM-only
# POST /escalation-events and POST /notifications. Optional: the job still
# transitions OPEN->MISSED when unset, just skips escalation/notification calls.
SERVICE_ACCOUNT_CLIENT_ID=visit-form-service
SERVICE_ACCOUNT_CLIENT_SECRET=
# node-cron expression for the missed-visit job. Default: every 30 minutes.
MISSED_VISIT_JOB_CRON=*/30 * * * *
# node-cron expression for the post-EDD visit-generation job (EDD+7
# delivery-form check). Default: once daily at 02:00.
POST_EDD_VISIT_JOB_CRON=0 2 * * *
