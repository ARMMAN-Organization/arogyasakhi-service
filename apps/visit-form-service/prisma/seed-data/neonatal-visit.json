    {
      "label": "Nutritional status (Underweight)",
      "options": [
        { "label": "Normal", "sort_order": 0, "value_code": "normal" },
        { "label": "MUW", "sort_order": 1, "value_code": "muw" },
        { "label": "SUW", "sort_order": 2, "value_code": "suw" }
