      "learnMoreTopicCode": "COMING_SOON",
      "visibleWhen": { "field": "is_newborn_alive_now", "operator": "eq", "value": "yes" }
    },
    {
      "label": "Any deformity observed in the newborn?",
      "options": [
        { "label": "Yes", "sort_order": 0, "value_code": "yes" },
