NODE_ENV=development
PORT=3006
LOG_LEVEL=debug
DATABASE_URL=postgresql://postgres.PROJECT_REF:REPLACE_ME@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
DIRECT_URL=postgresql://postgres.PROJECT_REF:REPLACE_ME@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
CORS_ORIGINS=http://localhost:5173
# Comma-separated public URLs for the Swagger "Servers" dropdown, e.g.
# https://staging-api.example.com,https://api.example.com. Leave empty in
# local dev to fall back to http://localhost:$PORT.
PUBLIC_BASE_URLS=
# Reopen request decisions call audit-service and notification-escalation-
# service through the gateway (forwarding the deciding Supervisor's own
# JWT) to write the audit entry and notify the Sakhi.
API_GATEWAY_BASE_URL=http://localhost:3000

# Optional — seeds one demo REOPEN Quick Response card (prisma/seed.ts). Unset →
# that seed step logs "skipped". See the root .env.example for what each var is
# and why (a real beneficiary/Sakhi id and a SAKHI/SUPERVISOR bearer token).
SEED_DEMO_BENEFICIARY_ID=
SEED_DEMO_SAKHI_USER_ID=
SEED_DEMO_AUTH_TOKEN=

# Shared HMAC secret used to verify that the trusted-identity headers
# (x-armman-user-id etc.) genuinely came from the API Gateway, not a
# forged direct request bypassing it — must match the gateway's own
# INTERNAL_HEADER_SECRET. Generate with e.g. `openssl rand -hex 32`.
INTERNAL_HEADER_SECRET=REPLACE_ME_WITH_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
