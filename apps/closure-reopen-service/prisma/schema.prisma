generator client {
  provider = "prisma-client-js"
  output   = "../../../node_modules/.prisma/client-closure-reopen-service"
}

datasource db {
  provider  = "postgresql"
  directUrl = env("DIRECT_URL")
  url       = env("DATABASE_URL")
}

// closure-reopen-service owns these tables only (forklift rule).
// Field/table definitions sourced from docs/Arogya_Sakhi_Database_Design_ERD_Table_Definitions.docx.md
// section "closures", "reopen_requests" (Appendix A).
// beneficiary_id / submitted_by_user_id / supervisor_id / requested_by_user_id /
// decision_reason_code_lookup_id / decided_by_user_id / supervisor_rejection_reason_code_lookup_id
// and all *_user_id audit columns are plain scalar columns, not Prisma relations,
// because beneficiary_cases, users, supervisor_profiles and lookup_values are
// owned by other services (no cross-service joins per the forklift rule).

enum ClosureType {
  MEDICAL
  NON_MEDICAL
  PROGRAM_COMPLETION
}

enum ClosureReason {
  MISCARRIAGE
  ABORTION
  MATERNAL_DEATH
  INFANT_OR_CHILD_DEATH
  MIGRATION
  WITHDRAWAL
  PROGRAM_CYCLE_COMPLETED
  OTHER
}

// Approval status required only when closure_reason = MIGRATION.
// NULL means supervisor approval is not applicable for the closure reason.
enum ClosureSupervisorStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ReopenRequestReason {
  MIGRATION_RETURNED
  CLOSED_BY_MISTAKE
  OTHER
}

enum ReopenSupervisorStatus {
  PENDING
  APPROVED
  REJECTED
}

model Closure {
  id                String                   @id @default(uuid()) @map("closure_id")
  // beneficiary_cases.beneficiary_id — owned by another service, no cross-service relation.
  beneficiaryId     String                   @map("beneficiary_id")
  closureType       ClosureType              @map("closure_type")
  closureReason     ClosureReason            @map("closure_reason")
  eventDate         DateTime?                @map("event_date") @db.Date
  closureDate       DateTime                 @map("closure_date") @db.Date
  // users.user_id — owned by another service, no cross-service relation.
  submittedByUserId String                   @map("submitted_by_user_id")
  supervisorStatus  ClosureSupervisorStatus? @map("supervisor_status")
  // supervisor_profiles.supervisor_id — owned by another service, no cross-service relation.
  supervisorId      String?                  @map("supervisor_id")
  supervisorNotes   String?                  @map("supervisor_notes")
  createdAt         DateTime                 @default(now()) @map("created_at")
  createdByUserId   String?                  @map("created_by_user_id")
  updatedAt         DateTime                 @updatedAt @map("updated_at")
  updatedByUserId   String?                  @map("updated_by_user_id")
  isDeleted         Boolean                  @default(false) @map("is_deleted")
  deletedAt         DateTime?                @map("deleted_at")

  @@map("closures")
}

model ReopenRequest {
  id                                    String                 @id @default(uuid()) @map("reopen_request_id")
  // beneficiary_cases.beneficiary_id — owned by another service, no cross-service relation.
  beneficiaryId                         String                 @map("beneficiary_id")
  requestReason                         ReopenRequestReason    @map("request_reason")
  // users.user_id — owned by another service, no cross-service relation.
  requestedByUserId                     String                 @map("requested_by_user_id")
  requestedAt                           DateTime               @map("requested_at")
  supervisorStatus                      ReopenSupervisorStatus @default(PENDING) @map("supervisor_status")
  // lookup_values.lookup_value_id — owned by another service, no cross-service relation.
  decisionReasonCodeLookupId            String?                @map("decision_reason_code_lookup_id")
  decisionNotes                         String?                @map("decision_notes")
  // users.user_id — owned by another service, no cross-service relation.
  decidedByUserId                       String?                @map("decided_by_user_id")
  decidedAt                             DateTime?              @map("decided_at")
  // users.user_id — owned by another service, no cross-service relation.
  supervisorId                          String?                @map("supervisor_id")
  // lookup_values.lookup_value_id — owned by another service, no cross-service relation.
  supervisorRejectionReasonCodeLookupId String?                @map("supervisor_rejection_reason_code_lookup_id")
  supervisorRejectionNotes              String?                @map("supervisor_rejection_notes")
  createdAt                             DateTime               @default(now()) @map("created_at")
  createdByUserId                       String?                @map("created_by_user_id")
  updatedAt                             DateTime               @updatedAt @map("updated_at")
  updatedByUserId                       String?                @map("updated_by_user_id")
  isDeleted                             Boolean                @default(false) @map("is_deleted")
  deletedAt                             DateTime?              @map("deleted_at")

  @@map("reopen_requests")
}
