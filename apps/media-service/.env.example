NODE_ENV=development
PORT=3011
LOG_LEVEL=debug
DATABASE_URL=postgresql://postgres.PROJECT_REF:REPLACE_ME@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
DIRECT_URL=postgresql://postgres.PROJECT_REF:REPLACE_ME@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
CORS_ORIGINS=http://localhost:5173
# Comma-separated public URLs for the Swagger "Servers" dropdown, e.g.
# https://staging-api.example.com,https://api.example.com. Leave empty in
# local dev to fall back to http://localhost:$PORT.
PUBLIC_BASE_URLS=

# S3 bucket that stores uploaded media. No AWS credentials are configured here —
# the AWS SDK uses its default credential provider chain (IAM task role in ECS,
# your own `aws configure`/SSO profile locally).
S3_BUCKET_NAME=arogya-media-dev
AWS_REGION=ap-south-1
# How long a presigned upload URL stays valid, in seconds.
PRESIGNED_URL_EXPIRY_SECONDS=900
# Largest file (in bytes) a presigned URL will be issued for. Default 25 MB.
MAX_UPLOAD_SIZE_BYTES=26214400
# Comma-separated MIME types allowed for upload.
ALLOWED_UPLOAD_MIME_TYPES=image/jpeg,image/png,image/webp,application/pdf
