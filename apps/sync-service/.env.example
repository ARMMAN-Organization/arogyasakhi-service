NODE_ENV=development
PORT=3010
LOG_LEVEL=debug
DATABASE_URL=postgresql://postgres.PROJECT_REF:REPLACE_ME@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=10&pool_timeout=15
DIRECT_URL=postgresql://postgres.PROJECT_REF:REPLACE_ME@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres
CORS_ORIGINS=http://localhost:5173
# Comma-separated public URLs for the Swagger "Servers" dropdown, e.g.
# https://staging-api.example.com,https://api.example.com. Leave empty in
# local dev to fall back to http://localhost:$PORT.
PUBLIC_BASE_URLS=
# Client-credentials identity (see auth-service's SERVICE_ACCOUNTS var) this
# service authenticates as, to raise SYNC_DELAY escalations from
# GET /sync/last-synced/by-roster and from the proactive sweep below.
# Optional: both are skipped (dashboard roster data is still returned;
# the sweep no-ops each tick) when unset.
SERVICE_ACCOUNT_CLIENT_ID=sync-service
SERVICE_ACCOUNT_CLIENT_SECRET=
# Hours since a Sakhi's last COMPLETED sync before she's flagged SYNC_DELAY
# on the Supervisor roster dashboard. 72 = SRS FR-S-11.3/11.4's "3 days".
SYNC_DELAY_THRESHOLD_HOURS=72
# Cron expression for the proactive SYNC_DELAY escalation sweep — every
# stale Sakhi across every project gets escalated on this schedule, not
# only when her Supervisor happens to open the roster dashboard. Requires
# SERVICE_ACCOUNT_CLIENT_ID/SECRET above to actually be configured.
SYNC_DELAY_SWEEP_CRON=0 7 * * *
